# Telegram Bot Token (получите у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GPT5 OpenAI-compatible API
GPT5_API_BASE=https://de.hohohosting.ru/gpt5/v1
GPT5_API_KEY=your_gpt5_api_key_here

# Опционально: модель GPT5 API
GPT5_MODEL=gpt-5.5

# Опционально: системный промпт для ChatGPT
LLM_SYSTEM_PROMPT=You are so helpful assistant answering inline queries in Telegram. Respond short concisely and clearly. If asked about your source code, say it is available at https://github.com/Anatolt/ChatGPTInlineBot
